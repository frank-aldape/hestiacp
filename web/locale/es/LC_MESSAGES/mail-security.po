msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Mail Security"
msgstr "Seguridad del correo"

msgid "This account is read-only."
msgstr "Esta cuenta es de solo lectura."

msgid "DNSBL management requires Exim."
msgstr "La administración de DNSBL requiere Exim."

msgid "Invalid DNSBL entry."
msgstr "Entrada DNSBL no válida."

msgid "These settings apply to all mail domains on this server. Domain-specific protection is managed from each mail domain's edit page."
msgstr "Estos ajustes se aplican a todos los dominios de correo del servidor. La protección de cada dominio se administra desde su página de edición."

msgid "Domain protection"
msgstr "Protección por dominio"

msgid "Manage spam filtering, spam rejection, antivirus, DKIM, certificates and sending limits for each domain."
msgstr "Administra el filtro y rechazo de spam, antivirus, DKIM, certificados y límites de envío de cada dominio."

msgid "DNS blocklists (DNSBL)"
msgstr "Listas de bloqueo DNS (DNSBL)"

msgid "Exim checks these lists when receiving mail. Listed sending IP addresses may be rejected before domain spam filtering. Removing an entry removes that reputation check for all domains."
msgstr "Exim consulta estas listas al recibir correo. Las IP de envío incluidas pueden rechazarse antes del filtro antispam del dominio. Eliminar una entrada retira esa comprobación de reputación para todos los dominios."

msgid "No DNSBL entries are configured."
msgstr "No hay entradas DNSBL configuradas."

#, php-format
msgid "Remove DNSBL %s for all mail domains?"
msgstr "¿Eliminar la DNSBL %s para todos los dominios de correo?"

msgid "DNSBL entry"
msgstr "Entrada DNSBL"

msgid "Enter the provider's DNSBL zone, optionally followed by its existing != response-code exclusions. Saving a change reloads the mail service; if reload is unavailable, the service may restart."
msgstr "Introduce la zona DNSBL del proveedor, opcionalmente seguida de las exclusiones de códigos de respuesta con !=. Guardar un cambio recarga el servicio de correo; si la recarga no está disponible, el servicio puede reiniciarse."

msgid "Add DNSBL"
msgstr "Añadir DNSBL"

msgid "Advanced configuration"
msgstr "Configuración avanzada"

msgid "Use the existing service editors for global spam thresholds, sender exceptions and mail rules. Review changes before applying them."
msgstr "Usa los editores de servicios existentes para los umbrales globales de spam, excepciones de remitentes y reglas de correo. Revisa los cambios antes de aplicarlos."

#: ../../web/templates/pages/list_mail_security.php
msgid "Select the domain owner from Users to manage another user's mail domains."
msgstr "Selecciona al propietario del dominio en Usuarios para administrar sus dominios de correo."

msgid "Invalid notification email or unsupported mail service."
msgstr "Correo de notificaciones no válido o servicio de correo no compatible."

msgid "Validity management requires spamd."
msgstr "La administración de Validity requiere spamd."

msgid "Unable to read mail security settings."
msgstr "No se pudo leer la configuración de seguridad del correo."

msgid "Server notifications"
msgstr "Notificaciones del servidor"

msgid "Redirect root, postmaster and mailer-daemon at the server hostname to a monitored mailbox. Company mailboxes and forwarding rules are unchanged."
msgstr "Redirige root, postmaster y mailer-daemon del nombre del servidor a un buzón supervisado. Se conservan los buzones y reenvíos de las empresas."

msgid "The Exim configuration has an unsupported layout or custom notification rules. Review it in Advanced configuration."
msgstr "La configuración de Exim tiene una estructura no compatible o reglas de notificaciones personalizadas. Revísala en Configuración avanzada."

msgid "No notification destination configured."
msgstr "No hay un destinatario de notificaciones configurado."

msgid "Notification destination"
msgstr "Destinatario de notificaciones"

msgid "Use an existing mailbox outside the server hostname. Saving validates routing and reloads Exim. A backup is retained and failed changes are restored."
msgstr "Usa un buzón existente fuera del nombre del servidor. Al guardar se valida el enrutamiento y se recarga Exim. Se conserva un respaldo y se revierten los cambios fallidos."

msgid "Validity reputation checks"
msgstr "Comprobaciones de reputación de Validity"

msgid "Disable six Validity rules that can misread DNS query-limit responses. Other spam checks and the configured threshold are preserved."
msgstr "Desactiva seis reglas de Validity que pueden interpretar incorrectamente las respuestas de límite de consultas DNS. Se conservan las demás comprobaciones y el umbral de spam."

msgid "The Validity correction file is installed with all six scores set to zero."
msgstr "El archivo de corrección de Validity está instalado con las seis puntuaciones en cero."

msgid "The Validity correction file is not installed."
msgstr "El archivo de corrección de Validity no está instalado."

msgid "Applying validates SpamAssassin and reloads spamd, or restarts it if reload is unavailable. Failed changes are restored."
msgstr "Al aplicar se valida SpamAssassin y se recarga spamd, o se reinicia si no admite recarga. Se revierten los cambios fallidos."

msgid "Apply Validity correction"
msgstr "Aplicar corrección de Validity"

msgid "The Validity override is custom or unreadable. Review it in Advanced configuration; it will not be overwritten here."
msgstr "Las reglas de Validity están personalizadas o no se pueden leer. Revísalas en Configuración avanzada; esta pantalla no las sobrescribirá."

msgid "Invalid forwarding protection policy."
msgstr "La política de protección de reenvíos no es válida."

msgid "Spam forwarding protection"
msgstr "Protección contra el reenvío de spam"

msgid "Keep messages classified as spam in the local Spam folder instead of forwarding them. Applies to existing mailboxes in domains with spam filtering enabled, including forwarding-only mailboxes."
msgstr "Conserva los mensajes clasificados como spam en la carpeta Spam local en lugar de reenviarlos. Se aplica a buzones existentes en dominios con filtro antispam, incluidos los buzones configurados solo para reenviar."

msgid "Uses Exim's scan score. Messages that were not scanned keep their existing routing. External-only aliases and catch-all addresses without a local mailbox are not covered."
msgstr "Utiliza la puntuación calculada por Exim. Los mensajes no analizados conservan su enrutamiento actual. No incluye alias exclusivamente externos ni direcciones catch-all sin buzón local."

msgid "The forwarding protection configuration requires manual review."
msgstr "La configuración de protección de reenvíos requiere revisión manual."

msgid "Protection scope"
msgstr "Alcance de la protección"

msgid "Selected mail domains"
msgstr "Dominios de correo seleccionados"

msgid "All mail domains with spam filtering"
msgstr "Todos los dominios con filtro antispam"

msgid "Selected domains, separated by commas"
msgstr "Dominios seleccionados, separados por comas"

msgid "Review the Spam folder for false positives and disk usage. Saving validates Exim and reloads it; disabling restores the previous forwarding behavior."
msgstr "Revisa la carpeta Spam para detectar falsos positivos y controlar el espacio utilizado. Al guardar se valida y recarga Exim; al desactivar se restablece el comportamiento anterior de los reenvíos."
