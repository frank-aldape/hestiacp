#!/bin/bash
# info: list per-user backup schedules
# options: NONE
source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
if [ "$#" -ne 0 ]; then
	check_result "$E_INVALID" "invalid backup schedule arguments"
fi
python3 "$HESTIA/install/common/backup_schedule.py" read
check_result $? "failed to read backup schedules"
