#!/bin/bash
# info: list aggregate webmail performance history
# options: [1|24|168]
source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"
if [ "$#" -gt 1 ] || [[ ! "${1:-24}" =~ ^(1|24|168)$ ]]; then
	check_result "$E_INVALID" "invalid monitoring period"
fi
python3 "$HESTIA/install/common/webmail_monitor.py" read "${1:-24}"
check_result $? "failed to read webmail metrics"
